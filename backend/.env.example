# Google Cloud Vision API Credentials
# Choose ONE option below:

# Option 1 - Local Development (recommended)
# Set path to your downloaded service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2 - Vercel/Production Deployment
# Paste the ENTIRE JSON content from your service account key file
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com"}